# Copy to .env and fill in. Never commit .env.

# Database: SQLite locally, Azure SQL in prod
DATABASE_URL=sqlite:///./fairprice.db
# DATABASE_URL=mssql+pyodbc://<user>:<password>@<server>.database.windows.net:1433/<db>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes

# Azure OpenAI (primary LLM)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Claude (fallback LLM)
ANTHROPIC_API_KEY=

# Azure Maps
AZURE_MAPS_KEY=

# Pricing assumptions
FAIR_TRADER_MARGIN=0.20
KES_TO_UGX=28.5

# Admin endpoint protection (used by Azure Functions -> /admin/refresh)
ADMIN_TOKEN=change-me
